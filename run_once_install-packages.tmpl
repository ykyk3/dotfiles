{{/* 共通パッケージリスト定義 */}}
{{- $packages := list "git" "neovim" "fzf" "ripgrep" "nodejs" "python" "go" "fd" "bat" "jq" "curl" "wget" "deno" -}}

{{ if eq .chezmoi.os "windows" -}}
# PowerShell script for Windows package installation

$Green = [ConsoleColor]::Green
$Yellow = [ConsoleColor]::Yellow
$Red = [ConsoleColor]::Red

function Write-ColorOutput {
    param([string]$Message, [ConsoleColor]$Color = [ConsoleColor]::White)
    Write-Host $Message -ForegroundColor $Color
}

function Test-Command {
    param([string]$Command)
    try {
        Get-Command $Command -ErrorAction Stop | Out-Null
        return $true
    }
    catch {
        return $false
    }
}

Write-ColorOutput "Installing packages for Windows..." $Green

# 共通パッケージリスト
$packages = @(
{{- range $packages }}
    "{{ . }}",
{{- end }}
)

# Try to detect which package manager to use
$UseScoop = $false
$UseChocolatey = $false

if (Test-Command "scoop") {
    $UseScoop = $true
    Write-ColorOutput "Detected Scoop, using it for package installation..." $Yellow
} elseif (Test-Command "choco") {
    $UseChocolatey = $true
    Write-ColorOutput "Detected Chocolatey, using it for package installation..." $Yellow
} else {
    Write-ColorOutput "No package manager detected. Installing Scoop..." $Yellow
    Set-ExecutionPolicy RemoteSigned -Scope CurrentUser -Force
    try {
        Invoke-RestMethod get.scoop.sh | Invoke-Expression
        $UseScoop = $true
        Write-ColorOutput "Scoop installed successfully!" $Green
    }
    catch {
        Write-ColorOutput "Failed to install Scoop. Please install it manually or use Chocolatey." $Red
        exit 1
    }
}

# Install packages
if ($UseScoop) {
    Write-ColorOutput "Installing packages via Scoop..." $Yellow
    scoop bucket add extras
    
    foreach ($package in $packages) {
        $pkgName = if ($package -eq "nodejs") { "nodejs" } elseif ($package -eq "python") { "python" } elseif ($package -eq "go") { "go" } else { $package }
        if (-not (Test-Command $pkgName)) {
            Write-ColorOutput "Installing $package..." $Yellow
            scoop install $package
        }
    }
}

if ($UseChocolatey) {
    Write-ColorOutput "Installing packages via Chocolatey..." $Yellow
    foreach ($package in $packages) {
        $pkgName = if ($package -eq "go") { "golang" } else { $package }
        Write-ColorOutput "Installing $pkgName..." $Yellow
        choco install $pkgName -y
    }
}

# 共通：ghqインストール
if (Test-Command "go") {
    if (-not (Test-Command "ghq")) {
        Write-ColorOutput "Installing ghq..." $Yellow
        go install github.com/x-motemen/ghq@latest
    }
}

# 共通：vim-plugインストール
$VimPlugPath = "$env:LOCALAPPDATA\nvim-data\site\autoload\plug.vim"
if (-not (Test-Path $VimPlugPath)) {
    Write-ColorOutput "Installing vim-plug..." $Yellow
    $VimPlugDir = Split-Path $VimPlugPath -Parent
    if (-not (Test-Path $VimPlugDir)) {
        New-Item -ItemType Directory -Path $VimPlugDir -Force | Out-Null
    }
    Invoke-WebRequest -Uri "https://raw.githubusercontent.com/junegunn/vim-plug/master/plug.vim" -OutFile $VimPlugPath
}

Write-ColorOutput "Package installation complete!" $Green

{{ else -}}
#!/bin/bash
set -e

# 色設定
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo -e "${GREEN}Installing packages for {{ .chezmoi.os }}...${NC}"

# 共通：コマンド存在チェック
command_exists() {
    command -v "$1" >/dev/null 2>&1
}

{{ if eq .chezmoi.os "darwin" -}}
# macOS setup
if ! command_exists brew; then
    echo -e "${YELLOW}Installing Homebrew...${NC}"
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    if [[ -d "/opt/homebrew" ]]; then
        echo 'eval "$(/opt/homebrew/bin/brew shellenv)"' >> ~/.zprofile
        eval "$(/opt/homebrew/bin/brew shellenv)"
    fi
fi

echo -e "${YELLOW}Installing packages via Homebrew...${NC}"
brew install {{ range $packages }}{{ . }} {{ end }}tmux ghq tig python3 eza

# fzf shell integrations
$(brew --prefix)/opt/fzf/install --all

{{ else if eq .chezmoi.os "linux" -}}
# Linux setup
echo -e "${YELLOW}Updating package list...${NC}"
sudo apt update

echo -e "${YELLOW}Installing packages via apt...${NC}"
sudo apt install -y {{ range $packages }}{{ if eq . "fd" }}fd-find{{ else if eq . "nodejs" }}nodejs npm{{ else if eq . "python" }}python3 python3-pip{{ else if eq . "deno" }}{{ else }}{{ . }}{{ end }} {{ end }}tmux build-essential

# Denoインストール
if ! command_exists deno; then
    echo -e "${YELLOW}Installing Deno...${NC}"
    curl -fsSL https://deno.land/install.sh | sh
fi

# Goインストール
if ! command_exists go; then
    echo -e "${YELLOW}Installing Go...${NC}"
    wget -q https://go.dev/dl/go1.21.0.linux-amd64.tar.gz -O /tmp/go.tar.gz
    sudo rm -rf /usr/local/go && sudo tar -C /usr/local -xzf /tmp/go.tar.gz
    rm /tmp/go.tar.gz
fi
{{ end -}}

# 共通：ghqインストール
if command_exists go; then
    if ! command_exists ghq; then
        echo -e "${YELLOW}Installing ghq...${NC}"
        export PATH=$PATH:/usr/local/go/bin
        go install github.com/x-motemen/ghq@latest
    fi
fi

# 共通：vim-plugインストール
VIM_PLUG_PATH="${XDG_DATA_HOME:-$HOME/.local/share}/nvim/site/autoload/plug.vim"
if [ ! -f "$VIM_PLUG_PATH" ]; then
    echo -e "${YELLOW}Installing vim-plug...${NC}"
    curl -fLo "$VIM_PLUG_PATH" --create-dirs \
        https://raw.githubusercontent.com/junegunn/vim-plug/master/plug.vim
fi

echo -e "${GREEN}Package installation complete!${NC}"
{{ end -}}